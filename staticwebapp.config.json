{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/*.{css,js,json,map,txt,xml,png,jpg,jpeg,gif,svg,ico,webp,woff,woff2,ttf,pdf}",
      "/assets/*",
      "/images/*",
      "/img/*",
      "/css/*",
      "/js/*"
    ]
  },
  "globalHeaders": {
    "X-Frame-Options": "SAMEORIGIN",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
